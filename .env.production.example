# ==============================================================
# Centralized IT Helpdesk System - Production Environment Configuration
# ==============================================================
# Copy this file to .env on your VPS before running Docker Compose:
#   cp .env.production.example .env
#   php artisan key:generate (or set APP_KEY)
# ==============================================================

APP_NAME="Centralized IT Helpdesk System"
APP_ENV=production
APP_KEY=base64:uehpVjkkw+ZNXDshbkbOOb+kjGo6BST2hgUY0/Bdl4M=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# URL akses aplikasi di VPS (Ganti dengan domain / subdomain Cloudflare atau IP VPS):
# Contoh: http://helpdesk.yourdomain.com atau http://103.xxx.xxx.xxx:8087
APP_URL=http://localhost:8087

# Port host VPS untuk Nginx Helpdesk (Port 8087 aman dari port 80 & 8081-8086 yang sudah terpakai di VPS)
APP_PORT=8087

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ==============================================================
# Database Configuration (PostgreSQL Container)
# ==============================================================
# Catatan: Berjalan di jaringan internal Docker ('postgres'),
# tidak mengekspos port ke host sehingga bebas konflik dengan database lain di VPS.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=helpdesk_db
DB_USERNAME=helpdesk_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!

RUN_MIGRATIONS=true

# ==============================================================
# Drivers (Database-backed for persistent background workers)
# ==============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================
# Mail Configuration (Optional / Log by default)
# ==============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@helpdesk.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================
# WhatsApp Notification Gateway (Baileys Container)
# ==============================================================
# Berjalan di internal Docker network ('whatsapp-gateway:3000'),
# aman dan tidak bentrok dengan wa_blast_engine (3000) atau uptime-kuma (3001) di VPS!
WHATSAPP_ENABLED=true
WHATSAPP_DRIVER=baileys
WHATSAPP_BAILEYS_URL=http://whatsapp-gateway:3000
